<section
  class="explorer"
  id="explorer"
  aria-label="Mapa y consulta de lockers"
  data-results-open="false"
>
  <div id="map" aria-label="Mapa de España con lockers disponibles"></div>
  <div class="left-stack" id="map-panels">
    <section class="parcel-panel panel" aria-labelledby="parcel-title">
      <div class="parcel-heading">
        <span class="parcel-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path
              d="m12 3 9 5v9l-9 5-9-5V8l9-5Zm0 0v9m9-4-9 4-9-4m9 4v10M7.5 5.5l9 5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linejoin="round"
            />
          </svg>
        </span>
        <div>
          <p class="eyebrow">LOCALIZADOR DE LOCKERS</p>
          <h2 id="parcel-title">Tu paquete</h2>
        </div>
      </div>
      <form
        id="parcel-form"
        aria-labelledby="parcel-title"
        aria-describedby="parcel-note"
        autocomplete="off"
      >
        <div class="parcel-fields">
          {[
            ['length', 'Largo', 'cm'],
            ['width', 'Ancho', 'cm'],
            ['height', 'Alto', 'cm'],
            ['weight', 'Peso', 'kg'],
          ].map(([id, label, unit]) => (
            <div class="parcel-field">
              <label for={`parcel-${id}`}>
                {label} <span>({unit})</span>
              </label>
              <div class="input-wrap">
                <input
                  id={`parcel-${id}`}
                  name={id}
                  type="number"
                  inputmode="decimal"
                  step="any"
                  min="0"
                  placeholder="—"
                  aria-describedby={`parcel-${id}-error`}
                />
                <span aria-hidden="true">{unit}</span>
              </div>
              <span class="field-error" id={`parcel-${id}-error`} hidden>
                Introduce un número mayor que cero.
              </span>
            </div>
          ))}
        </div>
        <p id="parcel-note">
          Anota tus medidas. No filtran lockers ni calculan envíos.
        </p>
      </form>
    </section>
    <section
      class="availability-panel panel"
      aria-label="Disponibilidad y controles"
    >
      <div class="metrics">
        <span>
          <strong id="available-count">—</strong>{' '}
          <span id="available-label">disponibles</span>
        </span>
        <span>
          <strong id="positioned-count">—</strong> en el mapa
        </span>
      </div>
      <div id="status" role="status" aria-live="polite" aria-atomic="true">
        Cargando lockers…
      </div>
      <button id="retry" type="button" hidden>
        Reintentar consulta
      </button>
      <div class="primary-actions">
        <button
          id="open-results"
          class="primary"
          type="button"
          aria-controls="results"
          aria-expanded="false"
        >
          Ver lockers{' '}
          <svg
            aria-hidden="true"
            width="14"
            height="14"
            viewBox="0 0 16 16"
            fill="none"
          >
            <path
              d="M2 4h12M2 8h12M2 12h12"
              stroke="currentColor"
              stroke-width="1.5"
            />
          </svg>
        </button>
        <button id="refresh" type="button">
          <span aria-hidden="true">↻</span> Actualizar
        </button>
      </div>
      <div class="secondary-actions">
        <span id="updated-at">Sin lectura todavía</span>
        <button id="spain-view" type="button">
          Ver España
        </button>
      </div>
      <p class="availability-note">
        Última lectura. No reserva celdas ni garantiza el tamaño de tu paquete.
      </p>
      <p id="tile-warning" class="tile-warning" role="status" hidden>
        No se ha podido cargar el fondo del mapa. Puedes consultar todos los
        lockers en el listado.
      </p>
    </section>
  </div>
  <section
    id="results"
    class="results-panel panel"
    aria-labelledby="results-title"
    hidden
  >
    <div class="results-heading">
      <div>
        <p class="eyebrow">EXPLORA LA RED</p>
        <h2 id="results-title">Lockers disponibles</h2>
      </div>
      <button
        id="close-results"
        type="button"
        aria-label="Cerrar listado de lockers"
      >
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16">
          <path d="m4 4 8 8m0-8-8 8" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </button>
    </div>
    <div
      id="results-scroll"
      class="results-scroll"
      tabindex="0"
      aria-label="Resultados de lockers"
    >
      <ul id="locker-list" aria-label="Lockers disponibles"></ul>
      <section
        id="locker-detail"
        class="detail"
        aria-label="Detalle del locker"
        aria-live="polite"
        hidden
      ></section>
      <p class="list-note">
        Selecciona un locker para consultar su ubicación y las celdas libres.
      </p>
    </div>
  </section>
</section>
<noscript>
  <p class="noscript">
    Activa JavaScript para consultar la disponibilidad y utilizar el mapa.
  </p>
</noscript>
<script>
  import '../scripts/locker-map';
</script>
