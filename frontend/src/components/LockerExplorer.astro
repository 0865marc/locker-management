---
import LocationSearch from './LocationSearch.astro';
---

<section
  class="explorer"
  id="explorer"
  aria-label="Mapa y consulta de lockers"
  data-results-open="false"
>
  <div id="map" aria-label="Mapa de España con lockers disponibles"></div>
  <div class="left-stack" id="map-panels">
    <section class="parcel-panel panel" aria-label="Consulta de paquetes">
      <div class="mode-tabs" role="tablist" aria-label="Consulta de paquetes">
        <button
          id="quote-tab"
          type="button"
          role="tab"
          aria-selected="true"
          aria-controls="quote-view"
          tabindex="0"
        >
          Cotizar envío
        </button>
        <button
          id="tracking-tab"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="tracking-view"
          tabindex="-1"
        >
          Localizar paquete
        </button>
      </div>
      <div id="quote-view" role="tabpanel" aria-labelledby="quote-tab">
        <LocationSearch id="pickup" label="Dirección de recogida" />
        <LocationSearch id="delivery" label="Dirección de entrega" />
        <form id="parcel-form" aria-labelledby="quote-tab" autocomplete="off">
          <div class="parcel-fields">
            {[
              ['length', 'Largo', 'cm'],
              ['width', 'Ancho', 'cm'],
              ['height', 'Alto', 'cm'],
              ['weight', 'Peso', 'kg'],
            ].map(([id, label, unit]) => (
              <div class="parcel-field">
                <label for={`parcel-${id}`}>
                  {label} <span>({unit})</span>
                </label>
                <div class="input-wrap">
                  <input
                    id={`parcel-${id}`}
                    name={id}
                    type="number"
                    inputmode="decimal"
                    step="any"
                    min="0"
                    placeholder="—"
                    aria-describedby={`parcel-${id}-error`}
                  />
                  <span aria-hidden="true">{unit}</span>
                </div>
                <span class="field-error" id={`parcel-${id}-error`} hidden>
                  Introduce un número mayor que cero.
                </span>
              </div>
            ))}
          </div>
        </form>
        <div
          class="availability-panel"
          role="group"
          aria-label="Disponibilidad"
        >
          <div id="status" role="status" aria-live="polite" aria-atomic="true">
            Cargando lockers…
          </div>
          <button id="retry" type="button" hidden>
            Reintentar consulta
          </button>
          <p id="tile-warning" class="tile-warning" role="status" hidden>
            No se ha podido cargar el fondo del mapa. Puedes consultar todos los
            lockers en el selector de destino.
          </p>
        </div>
        <div class="metrics">
          <span>
            <strong id="available-count">—</strong>{' '}
            <span id="available-label">disponibles</span>
          </span>
          <span>
            <strong id="positioned-count">—</strong> en el mapa
          </span>
        </div>
      </div>
      <div
        id="tracking-view"
        role="tabpanel"
        aria-labelledby="tracking-tab"
        hidden
        inert
      >
        <form id="tracking-form" novalidate>
          <label for="tracking-id">UUID del paquete</label>
          <input
            id="tracking-id"
            autocomplete="off"
            spellcheck="false"
            placeholder="UUID de entrega o devolución"
            aria-describedby="tracking-help tracking-error"
          />
          <p id="tracking-help" class="address">
            Usa el identificador de una entrega o devolución, no la referencia
            de cotización.
          </p>
          <span id="tracking-error" class="field-error" hidden></span>
          <button id="tracking-submit" type="submit" class="primary">
            Localizar paquete
          </button>
        </form>
        <div
          id="tracking-status"
          role="status"
          aria-live="polite"
          aria-atomic="true"
        ></div>
        <button id="tracking-retry" type="button" hidden>
          Reintentar localización
        </button>
        <section
          id="tracking-result"
          aria-label="Resultado del seguimiento"
          hidden
        ></section>
        <p id="tracking-tile-warning" class="tile-warning" hidden>
          No se ha podido cargar el fondo del mapa. El resultado del seguimiento
          sigue disponible.
        </p>
      </div>
    </section>
  </div>
  <section
    id="results"
    class="results-panel panel"
    aria-labelledby="results-title"
    hidden
  >
    <div class="results-heading">
      <div>
        <p class="eyebrow">COTIZADOR DEMO</p>
        <h2 id="results-title">Enviar a este locker</h2>
      </div>
      <button id="close-results" type="button" aria-label="Cerrar cotizador">
        ×
      </button>
    </div>
    <div class="results-scroll">
      <form id="shipping-form" novalidate>
        <label for="destination-locker">Locker de destino</label>
        <select id="destination-locker">
          <option value="">Elige un locker disponible</option>
        </select>
        <p id="destination-address" class="address"></p>
        <p id="destination-position" class="unmapped" hidden>
          Ubicación no disponible en el mapa.
        </p>
        <div class="postal-fields">
          <div>
            <label for="origin-postal">CP de origen</label>
            <input
              id="origin-postal"
              inputmode="numeric"
              autocomplete="postal-code"
              maxlength="5"
              placeholder="28001"
              aria-describedby="origin-postal-error"
            />
            <span class="field-error" id="origin-postal-error" hidden></span>
          </div>
          <div>
            <label for="destination-postal">CP de destino</label>
            <input
              id="destination-postal"
              inputmode="numeric"
              maxlength="5"
              placeholder="01001"
              aria-describedby="destination-postal-note destination-postal-error"
            />
            <span
              class="field-error"
              id="destination-postal-error"
              hidden
            ></span>
          </div>
        </div>
        <p id="destination-postal-note" class="address"></p>
        <button id="compare-shipping" class="primary" type="submit">
          Comparar envíos
        </button>
      </form>
      <p class="demo-note">
        Simulación demo: proveedores, precios y plazos simulados. No reserva el
        locker ni crea un envío.
      </p>
      <div
        id="quotation-status"
        role="status"
        aria-live="polite"
        aria-atomic="true"
      ></div>
      <p id="quotation-reference" class="address" hidden></p>
      <button id="quotation-resume" type="button" hidden>
        Seguir consultando
      </button>
      <div id="quotation-offers" aria-label="Resultados de cotización"></div>
    </div>
  </section>
</section>
<noscript>
  <p class="noscript">
    Activa JavaScript para consultar la disponibilidad y utilizar el mapa.
  </p>
</noscript>
<script>
  import '../scripts/locker-map';
</script>
