---
import LockerExplorer from '../components/LockerExplorer.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Explora lockers disponibles en España y anota las medidas de tu paquete."
    />
    <title>Localizador de lockers</title>
  </head>
  <body>
    <a class="skip-link" id="skip-results" href="#results">
      Ir a los lockers
    </a>
    <main>
      <h1 class="sr-only">Localizador de lockers en España</h1>
      <LockerExplorer />
    </main>
  </body>
</html>
