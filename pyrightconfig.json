{
  "include": [
    "backend",
    "deploy/cloudflare/runtime_spike",
    "deploy/cloudflare/tests",
    "scripts/cloudflare"
  ],
  "exclude": [
    "**/.venv",
    "**/__pycache__",
    "**/.pytest_cache",
    "**/.mypy_cache",
    "backend/adapters/database/migrations/versions/0001_create_delivery_and_return.py",
    "backend/adapters/database/migrations/versions/0002_parcel_custody.py",
    "backend/adapters/database/migrations/versions/0003_lockers_and_custody.py"
  ],
  "typeCheckingMode": "standard",
  "strict": [
    "backend/domain",
    "backend/application",
    "backend/adapters",
    "backend/composition.py",
    "deploy/cloudflare/runtime_spike",
    "scripts/cloudflare",
    "backend/entrypoints"
  ],
  "pythonVersion": "3.11",
  "venvPath": "backend",
  "venv": ".venv",
  "executionEnvironments": [
    {
      "root": "deploy/cloudflare",
      "pythonVersion": "3.13",
      "extraPaths": [
        "backend",
        "deploy/cloudflare/runtime_spike",
        "scripts/cloudflare"
      ]
    },
    {
      "root": "scripts/cloudflare",
      "pythonVersion": "3.13",
      "extraPaths": [
        "backend"
      ]
    },
    {
      "root": "backend/entrypoints/cloudflare",
      "pythonVersion": "3.13",
      "extraPaths": [
        "backend"
      ]
    },
    {
      "root": "backend"
    }
  ],
  "stubPath": "deploy/cloudflare/typings"
}
