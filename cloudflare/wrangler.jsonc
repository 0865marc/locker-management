{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "locker-management-demo",
  "main": ".production/cloudflare_worker.py",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "python_workers"
  ],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "locker-management-demo",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "QUOTATIONS",
        "queue": "locker-management-quotations"
      }
    ],
    "consumers": [
      {
        "queue": "locker-management-quotations",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_retries": 0
      }
    ]
  }
}
