{
  "name": "locker-management-runtime-spike",
  "main": ".prepared/bootstrap.py",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "python_workers"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "runtime-spike",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "QUOTATIONS",
        "queue": "runtime-spike"
      }
    ],
    "consumers": [
      {
        "queue": "runtime-spike",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_retries": 0
      }
    ]
  },
  "vars": {
    "LABEL": "native-local"
  }
}
